@model Company

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
           <div class="col-12 text-center">
                <h2 class="text-white py-2">@(Model.Id != 0 ? "Edit Company" : "Create Company")</h2>
           </div>
        </div>
    </div>
     <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            

            <div class="row">
                <div class="col-12">
                    <div class="border  p-3 mt-4">

                        @*  <div asp-validation-summary="ModelOnly"></div> *@
                        <div class="mb-3 row">
                            <label asp-for="Name" class="p-0"></label>
                            <input asp-for="Name" class="form-control border border-secondary" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                      

                        <div class="mb-3 row">
                            <label asp-for="StreetAddress" class="p-0"></label>
                            <input asp-for="StreetAddress" class="form-control border border-secondary" />
                            <span asp-validation-for="StreetAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="City" class="p-0"></label>
                            <input asp-for="City" class="form-control border border-secondary" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="State" class="p-0"></label>
                            <input asp-for="State" class="form-control border border-secondary" />
                            <span asp-validation-for="State" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="PostalCode" class="p-0"></label>
                            <input asp-for="PostalCode" class="form-control border border-secondary" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="PhoneNumber" class="p-0"></label>
                            <input asp-for="PhoneNumber" class="form-control border border-secondary" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                     

                        <div class="row mt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Id != 0)
                                {
                                    <button type="submit"
                                            class="btn btn-primary form-control fw-bold">
                                        Edit
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-primary form-control fw-bold">
                                        Create
                                    </button>
                                }

                            </div>

                            <div class="col-6 col-md-3">
                                <a asp-controller="Company" asp-action="Index"
                                   class="btn btn-outline-dark form-control fw-bold">
                                    Back to List
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
               
            </div>

            
        </form>
     </div>
</div>




@*Client side validation *@
