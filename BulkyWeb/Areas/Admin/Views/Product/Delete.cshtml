@model Product

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Delete Product</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form method="post" class="row">
            <div class="border  p-3 mt-4">
                <div class="row pb-2">
                </div>

                @*  <div asp-validation-summary="ModelOnly"></div> *@
                <div class="mb-3 row">
                    <label asp-for="Title" disabled class="p-0"></label>
                    <input asp-for="Title" class="form-control border border-secondary" />
                    
                </div>

                <div class="mb-3 row">
                    <label asp-for="Description" disabled class="p-0"></label>
                    <input asp-for="Description" class="form-control border border-secondary" />
                   
                </div>

                <div class="mb-3 row">
                    <label asp-for="ISBN" disabled class="p-0"></label>
                    <input asp-for="ISBN" class="form-control border border-secondary" />
                   
                </div>

                <div class="mb-3 row">
                    <label asp-for="Author" disabled class="p-0"></label>
                    <input asp-for="Author" class="form-control border border-secondary" />
                    
                </div>

                <div class="mb-3 row">
                    <label asp-for="ListPrice" disabled class="p-0"></label>
                    <input asp-for="ListPrice" class="form-control border border-secondary" />
               
                </div>

                <div class="mb-3 row">
                    <label asp-for="Price" disabled class="p-0"></label>
                    <input asp-for="Price" class="form-control border border-secondary" />
                    
                </div>

                <div class="mb-3 row">
                    <label asp-for="Price50" disabled class="p-0"></label>
                    <input asp-for="Price50" class="form-control border border-secondary" />
                  
                </div>

                <div class="mb-3 row">
                    <label asp-for="Price100" disabled class="p-0"></label>
                    <input asp-for="Price100" class="form-control border border-secondary" />
                    
                </div>

                <div class="row mt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit"
                                class="btn btn-danger form-control fw-bold">
                            Delete
                        </button>
                    </div>

                    <div class="col-6 col-md-3">
                        <a asp-controller="Product" asp-action="Index"
                           class="btn btn-outline-dark form-control fw-bold">
                            Back to List
                        </a>
                    </div>
                </div>


            </div>
        </form>
    </div>
</div>



