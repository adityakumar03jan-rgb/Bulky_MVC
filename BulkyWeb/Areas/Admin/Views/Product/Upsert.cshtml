@model ProductVM

<div class="card shadow border-0 my-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
           <div class="col-12 text-center">
                <h2 class="text-white py-2">@(Model.Product.Id != 0 ? "Edit Product" : "Create Product")</h2>
           </div>
        </div>
    </div>
     <div class="card-body p-4">
        <form method="post" class="row" enctype="multipart/form-data">
            <input type="hidden" asp-for="Product.Id" />
            <input type="hidden" asp-for="Product.ImageUrl" />

            <div class="row">
                <div class="col-10">
                    <div class="border  p-3 mt-4">

                        @*  <div asp-validation-summary="ModelOnly"></div> *@
                        <div class="mb-3 row">
                            <label asp-for="Product.Title" class="p-0"></label>
                            <input asp-for="Product.Title" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.Description" class="p-0 "></label>
                            <textarea asp-for="Product.Description" class="form-control border border-secondary"></textarea>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.ISBN" class="p-0"></label>
                            <input asp-for="Product.ISBN" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.ISBN" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.Author" class="p-0"></label>
                            <input asp-for="Product.Author" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.Author" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.ListPrice" class="p-0"></label>
                            <input asp-for="Product.ListPrice" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.Price" class="p-0"></label>
                            <input asp-for="Product.Price" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.Price50" class="p-0"></label>
                            <input asp-for="Product.Price50" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.Price50" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.Price100" class="p-0"></label>
                            <input asp-for="Product.Price100" class="form-control border border-secondary" />
                            <span asp-validation-for="Product.Price100" class="text-danger"></span>
                        </div>

                        <div class="mb-3 row">
                            <label asp-for="Product.CategoryId" class="ms-2 p-0"></label>
                            <select asp-for="@Model.Product.CategoryId" asp-items="@Model.CategoryList" style="color: #1a1a1a;" class="form-select border-0 shadow">
                                <option disabled selected>--Select Category--</option>
                            </select>
                            <span asp-validation-for="Product.CategoryId" class="text-danger"></span>

                            <div class="mb-3 row">
                                <label asp-for="Product.ImageUrl" style="color: #1a1a1a;" class="  form-floating p-2 col-12"></label>
                                <input type="file" name="file" class=" style=" color: #1a1a1a;" form-control border-0 shadow" />
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-6 col-md-3">
                                @if (Model.Product.Id != 0)
                                {
                                    <button type="submit"
                                            class="btn btn-primary form-control fw-bold">
                                        Edit
                                    </button>
                                }
                                else
                                {
                                    <button type="submit"
                                            class="btn btn-primary form-control fw-bold">
                                        Create
                                    </button>
                                }

                            </div>

                            <div class="col-6 col-md-3">
                                <a asp-controller="Product" asp-action="Index"
                                   class="btn btn-outline-dark form-control fw-bold">
                                    Back to List
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="col-2">
                    <img src="@Model.Product.ImageUrl" width="100%" 
                    style="border-radius:5px; border:1px solid #bbb9b9"/>
                </div>
            </div>

            
        </form>
     </div>
</div>




@*Client side validation *@
